# Copier en .env puis adapter. Ne jamais versionner le .env.

NODE_ENV=production
PORT=3100
# Adresse d'écoute : 127.0.0.1, Nginx est le seul point d'entrée public.
HOST=127.0.0.1

# Base SQLite, hors du dépôt et hors de la racine web.
DATABASE_URL="file:/var/lib/outil-devis/data.db"

# Captures d'écran : dossier hors de la racine web, servi par une route authentifiée.
UPLOAD_DIR=/var/lib/outil-devis/uploads

# Secret des cookies de session, à générer par :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Durée de session en heures.
SESSION_HOURS=12

# true en production (HTTPS). false uniquement en développement local sur http.
COOKIE_SECURE=true

# Taille maximale d'une capture envoyée, en mégaoctets (compressée ensuite si > 500 Ko).
MAX_UPLOAD_MB=15
